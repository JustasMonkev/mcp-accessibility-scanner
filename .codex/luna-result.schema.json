{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "tool", "evidence"],
  "properties": {
    "status": { "enum": ["PASS", "FAIL"] },
    "tool": { "type": "string", "minLength": 1 },
    "evidence": { "type": "string", "minLength": 1 }
  }
}
