{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "lib/",
    "coverage/",
    "tools/oxlint/anti-slop/"
  ],
  "plugins": [
    "import",
    "typescript",
    "promise",
    "vitest",
    "oxc"
  ],
  "jsPlugins": [
    "@stylistic/eslint-plugin",
    "eslint-plugin-notice",
    "./tools/oxlint/anti-slop/index.ts",
    "./tools/oxlint/comments/index.ts"
  ],
  "rules": {
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "ts": "always"
      }
    ],
    "typescript/no-floating-promises": "error",
    "no-unused-vars": [
      "error",
      {
        "args": "none",
        "caughtErrors": "none"
      }
    ],
    "@stylistic/object-curly-spacing": [
      "error",
      "always"
    ],
    "@stylistic/quotes": [
      "error",
      "single",
      {
        "avoidEscape": true,
        "allowTemplateLiterals": "always"
      }
    ],
    "@stylistic/jsx-quotes": [
      "error",
      "prefer-single"
    ],
    "@stylistic/no-extra-semi": "error",
    "@stylistic/semi": "error",
    "@stylistic/comma-style": [
      "error",
      "last"
    ],
    "@stylistic/wrap-iife": [
      "error",
      "inside"
    ],
    "@stylistic/spaced-comment": [
      "error",
      "always",
      {
        "markers": [
          "*"
        ]
      }
    ],
    "eqeqeq": "error",
    "accessor-pairs": [
      "error",
      {
        "getWithoutSet": false,
        "setWithoutGet": false
      }
    ],
    "@stylistic/brace-style": [
      "error",
      "1tbs",
      {
        "allowSingleLine": true
      }
    ],
    "curly": [
      "error",
      "multi-or-nest",
      "consistent"
    ],
    "@stylistic/new-parens": "error",
    "@stylistic/arrow-parens": [
      "error",
      "as-needed"
    ],
    "prefer-const": "error",
    "@stylistic/quote-props": [
      "error",
      "consistent"
    ],
    "@stylistic/nonblock-statement-body-position": [
      "error",
      "below"
    ],
    "no-var": "error",
    "no-with": "error",
    "no-multi-str": "error",
    "no-caller": "error",
    "no-implied-eval": "error",
    "no-labels": "error",
    "no-object-constructor": "error",
    "no-self-compare": "error",
    "no-shadow-restricted-names": "error",
    "no-cond-assign": "error",
    "no-debugger": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty-character-class": "error",
    "no-unreachable": "error",
    "no-unsafe-negation": "error",
    "radix": "error",
    "valid-typeof": "error",
    "no-implicit-globals": "error",
    "no-unused-expressions": [
      "error",
      {
        "allowShortCircuit": true,
        "allowTernary": true,
        "allowTaggedTemplates": true
      }
    ],
    "no-proto": "error",
    "require-yield": "error",
    "@stylistic/template-curly-spacing": [
      "error",
      "never"
    ],
    "@stylistic/space-infix-ops": "error",
    "@stylistic/space-in-parens": [
      "error",
      "never"
    ],
    "@stylistic/array-bracket-spacing": [
      "error",
      "never"
    ],
    "@stylistic/comma-spacing": [
      "error",
      {
        "before": false,
        "after": true
      }
    ],
    "@stylistic/space-before-function-paren": [
      "error",
      {
        "anonymous": "never",
        "named": "never",
        "asyncArrow": "always"
      }
    ],
    "@stylistic/no-whitespace-before-property": "error",
    "@stylistic/keyword-spacing": [
      "error",
      {
        "overrides": {
          "if": {
            "after": true
          },
          "else": {
            "after": true
          },
          "for": {
            "after": true
          },
          "while": {
            "after": true
          },
          "do": {
            "after": true
          },
          "switch": {
            "after": true
          },
          "return": {
            "after": true
          }
        }
      }
    ],
    "@stylistic/arrow-spacing": [
      "error",
      {
        "after": true,
        "before": true
      }
    ],
    "@stylistic/type-annotation-spacing": "error",
    "@stylistic/no-multiple-empty-lines": [
      "error",
      {
        "max": 2,
        "maxEOF": 0
      }
    ],
    "@stylistic/no-mixed-spaces-and-tabs": "error",
    "@stylistic/no-trailing-spaces": "error",
    "@stylistic/key-spacing": [
      "error",
      {
        "beforeColon": false
      }
    ],
    "@stylistic/eol-last": "error",
    "notice/notice": [
      "error",
      {
        "mustMatch": "Copyright",
        "templateFile": "utils/copyright.js"
      }
    ],
    "no-console": "error",
    "array-callback-return": "error",
    "default-case-last": "error",
    "import/no-absolute-path": "error",
    "import/no-duplicates": "error",
    "import/no-empty-named-blocks": "error",
    "import/no-self-import": "error",
    "no-case-declarations": "error",
    "no-constructor-return": "error",
    "no-empty-pattern": "error",
    "no-new-wrappers": "error",
    "no-prototype-builtins": "error",
    "no-sequences": "error",
    "no-unmodified-loop-condition": "error",
    "no-useless-assignment": "error",
    "no-useless-call": "error",
    "no-useless-rename": "error",
    "prefer-promise-reject-errors": "error",
    "promise/no-multiple-resolved": "error",
    "promise/no-new-statics": "error",
    "promise/no-return-in-finally": "error",
    "promise/valid-params": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-useless-empty-export": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-ts-expect-error": "error",
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error"
  },
  "overrides": [
    {
      "files": [
        "src/tools/axe.ts",
        "src/tools/axeFrameTree.ts",
        "tests/tools-axe.test.ts",
        "tests/tools-axeFrameTree.test.ts"
      ],
      "rules": {
        "comments/no-comments": "error"
      }
    },
    {
      "files": [
        "tests/tools-axe.test.ts"
      ],
      "rules": {
        "comments/no-comments": [
          "error",
          {
            "allowed": 29
          }
        ]
      }
    },
    {
      "files": [
        "src/tools/axe.ts",
        "src/tools/auditSite.ts",
        "src/tools/scanPageMatrix.ts",
        "src/tools/auditKeyboard.ts",
        "src/tools/auditScreenReader.ts",
        "src/tools/report.ts",
        "src/utils/htmlPatterns.ts",
        "src/utils/representativeUrls.ts",
        "tests/tools-auditScreenReader.test.ts",
        "tests/tools-auditSite.test.ts",
        "tests/tools-axe.test.ts",
        "tests/tools-scanPageMatrix.test.ts",
        "tests/tools-auditKeyboard.test.ts",
        "tests/tools-auditSite.integration.test.ts",
        "tests/htmlPatterns.test.ts",
        "tests/representativeUrls.test.ts",
        "bench/**",
        "scripts/**"
      ],
      "rules": {
        "notice/notice": "off"
      }
    },
    {
      "files": [
        ".codex/run-mcp-direct-harness.mjs",
        ".codex/run-mcp-tool-loop.mjs",
        "scripts/**"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "src/utils/terminal.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "src/**/*.ts"
      ],
      "rules": {
        "no-nested-ternary": "error",
        "max-params": [
          "error",
          {
            "max": 5
          }
        ],
        "typescript/no-misused-promises": "error",
        "typescript/switch-exhaustiveness-check": [
          "error",
          {
            "considerDefaultExhaustiveForUnions": true
          }
        ],
        "anti-slop/no-chained-type-assertions": "error"
      }
    },
    {
      "files": [
        "src/tools/**/*.ts",
        "src/mcp/**/*.ts",
        "src/utils/**/*.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "error"
      }
    },
    {
      "files": [
        "tests/**/*.test.ts"
      ],
      "rules": {
        "vitest/no-focused-tests": "error",
        "vitest/no-identical-title": "error",
        "vitest/no-duplicate-hooks": "error",
        "vitest/valid-describe-callback": "error",
        "vitest/valid-title": "error",
        "vitest/valid-expect-in-promise": "error"
      }
    },
    {
      "files": [
        "scripts/*.test.mjs"
      ],
      "rules": {
        "typescript/no-floating-promises": [
          "error",
          {
            "allowForKnownSafeCalls": [
              {
                "from": "package",
                "package": "@types/node",
                "name": [
                  "describe",
                  "test"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "tests/**/*.integration.test.ts"
      ],
      "rules": {
        "anti-slop/no-module-mocking": "error"
      }
    }
  ]
}
